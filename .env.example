# API configuration. Local commands read .env; Render environment variables take precedence.
CORS_ORIGINS=http://localhost:5173
MODULE5_CHECKPOINT_PATH=model_development/models/saved/xgboost_churn.json
MODULE5_PREPROCESSOR_PATH=artifacts/module5/preprocessor.joblib
MODULE5_MANIFEST_PATH=artifacts/module5/manifest.json
CUSTOMERS_CSV_PATH=data/official/module5_customer_features.csv
SEGMENTATION_CUSTOMERS_CSV_PATH=data/official/customer_features.csv
SUPABASE_URL=https://exifwzbacchvvtzckxcw.supabase.co
# Obtain the actual Session pooler connection string from Supabase Connect.
# Never use SUPABASE_URL as the PostgreSQL connection string.
DATABASE_URL=
# Optional separate owner connection for schema migration.
MIGRATION_DATABASE_URL=
MONITORING_DATABASE_ROLE=bank_monitoring_writer
MONITORING_ADMIN_TOKEN=
ENABLE_MONITORING_DEMO=false
# Optional private offline serving/demo bundle. Configure all three together on Render.
DEMO_DATA_DIR=
DEMO_ARTIFACT_URL=
DEMO_ARTIFACT_SHA256=
# Alternative to the private bundle: generate and validate at build time.
DEMO_BUILD_MODE=
# Optional local operator credential for Render API setup; never copy this key to the web app.
RENDER_API_KEY=
